{
  "name": "jianying-mcp",
  "version": "1.0.0",
  "description": "MiniMax-native MCP server for JianYing (\u526a\u6620) draft automation \u2014 zero runtime dependencies",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "jianying-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "verify": "node dist/verify.js",
    "scenario": "node dist/ad_scenario.js",
    "compare": "node dist/gen_compare.js",
    "validate-plugin": "python3 scripts/validate_plugin.py plugin",
    "sync-plugin": "cp dist/server.js dist/draft.js plugin/server/ && cp skills/jianying-editor/SKILL.md plugin/skills/jianying-editor/SKILL.md",
    "guards": "node dist/guard_coverage.js",
    "verify-drafts": "node dist/make_verify_drafts.js",
    "mutation": "node dist/mutation_check.js"
  },
  "keywords": [
    "jianying",
    "capcut",
    "jianying-pro",
    "mcp",
    "model-context-protocol",
    "video-editing",
    "minimax",
    "\u526a\u6620"
  ],
  "license": "MIT",
  "author": "Hou Tao",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ppppan9/jianying-mcp.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
